{
  "name": "B2B Follow-Up Drafts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "id": "schedule-trigger",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://scombinator-backend.onrender.com/api/companies/with-oauth",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [460, 300],
      "id": "get-companies",
      "name": "Get Companies with OAuth"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const companies = $input.all().map(i => i.json).filter(c => c.has_oauth_connected);\nif (companies.length === 0) return [];\nreturn companies.map(c => ({ json: { company_id: c.company_id, company_name: c.name } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "filter-companies",
      "name": "Filter Companies with OAuth"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://scombinator-backend.onrender.com/api/outbound/b2b/leads-due-for-follow-up?company_id={{ $json.company_id }}&api_key={{ $env.N8N_SERVICE_API_KEY }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.N8N_SERVICE_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          },
          "timeout": 30000,
          "continueOnFail": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [900, 300],
      "id": "get-leads-due",
      "name": "Get Leads Due for Follow-Up"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const lid = (l) => { if (!l || typeof l !== 'object') return ''; const id = l.Lead_ID ?? l.ID ?? ''; return String(id).trim(); };\nconst out = [];\nfor (const item of $input.all()) {\n  const res = item.json;\n  if (!res || typeof res !== 'object') continue;\n  const company_id = String(res.company_id || '').trim();\n  if (!company_id) continue;\n  for (const lead of res.leads_to_mark_stopped || []) {\n    const l = lid(lead);\n    if (l) out.push({ json: { company_id, lead_id: l, action: 'mark_stopped' } });\n  }\n  for (const lead of res.leads_due_for_draft || []) {\n    const l = lid(lead);\n    if (l) out.push({ json: { company_id, lead_id: l, action: 'create_draft' } });\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "id": "prepare-actions",
      "name": "Prepare Actions"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-mark-stopped",
              "leftValue": "={{ $json.action }}",
              "rightValue": "mark_stopped",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300],
      "id": "if-action",
      "name": "Mark Stopped or Create Draft?"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://scombinator-backend.onrender.com/api/outbound/b2b/leads/{{ $json.lead_id }}/mark-outreach-stopped?company_id={{ $json.company_id }}&api_key={{ $env.N8N_SERVICE_API_KEY }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.N8N_SERVICE_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          },
          "timeout": 15000,
          "continueOnFail": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1560, 200],
      "id": "mark-outreach-stopped",
      "name": "Mark Lead Outreach Stopped"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://scombinator-backend.onrender.com/api/outbound/create?api_key={{ $env.N8N_SERVICE_API_KEY }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.N8N_SERVICE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"company_id\": \"{{ $json.company_id }}\",\n  \"lead_id\": \"{{ $json.lead_id }}\",\n  \"intent\": \"Follow-up Check-in\",\n  \"trigger_type\": \"time_based\",\n  \"email_type\": \"B2B\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          },
          "timeout": 90000,
          "continueOnFail": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1560, 400],
      "id": "create-follow-up-draft",
      "name": "Create Follow-Up Draft"
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger": {
      "main": [
