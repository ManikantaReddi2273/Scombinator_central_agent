# Same key as backend N8N_SERVICE_API_KEY (Render Environment + backend/.env)
N8N_SERVICE_API_KEY=your-secret-key-set-same-in-backend-env

# Public backend URL used by workflows after Render deploy
BACKEND_API_URL=https://scombinator-backend.onrender.com

# Public frontend URL (OAuth redirect)
FRONTEND_URL=https://scombinator-frontend.onrender.com
